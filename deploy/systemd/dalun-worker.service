[Unit]
Description=Dalun research worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dalun
Group=dalun
WorkingDirectory=/opt/dalun/backend
Environment=DALUN_ENV_FILE=/etc/dalun/native.env
ExecStart=/opt/dalun/web-venv/bin/python -m app.documents.cli worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dalun
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
