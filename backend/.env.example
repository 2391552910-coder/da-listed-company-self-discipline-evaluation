# Explicitly set DALUN_ENV_FILE to load this file. Never commit your real .env.
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/self_discipline
APP_DATA_ROOT=./runtime
# Absolute path to the separate CUDA interpreter on Windows/Linux.
MODEL_PYTHON=python
MODEL_TIMEOUT_SECONDS=3600
MAX_UPLOAD_BYTES=104857600
