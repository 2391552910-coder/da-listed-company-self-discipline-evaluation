# Explicitly set DALUN_ENV_FILE to load this file. Never commit your real .env.
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/self_discipline
# Alternatively leave APP_DATABASE_URL blank and use connection fields. Passwords
# with @/:#% are safely encoded; never interpolate raw passwords into a URL.
# APP_DATABASE_HOST=localhost
# APP_DATABASE_PORT=5432
# APP_DATABASE_NAME=self_discipline
# APP_DATABASE_USER=postgres
# APP_DATABASE_PASSWORD=
APP_DATA_ROOT=./runtime
# Absolute path to the separate CUDA interpreter on Windows/Linux.
MODEL_PYTHON=python
MODEL_TIMEOUT_SECONDS=3600
MAX_UPLOAD_BYTES=104857600

# Optional override path; qwen3 always verifies this frozen tokenizer digest.
REFERENCE_TOKENIZER_FILE=
REFERENCE_TOKENIZER_SHA256=def76fb086971c7867b829c23a26261e38d9d74e02139253b38aeb9df8b4b50a

# Stage 4: server-side OpenAI-compatible generation profile. No mock fallback.
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=
LLM_MODEL=
# Blank omits sampling parameters (some reasoning models require fixed values).
LLM_TEMPERATURE=
LLM_JSON_MODE=true
